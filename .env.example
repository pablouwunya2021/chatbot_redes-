# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your Google Gemini API key. Get one free at https://aistudio.google.com/apikey
# (Google AI Studio gives a free tier; no credit card required).
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by the chatbot host (any Gemini model your key can access).
GEMINI_MODEL=gemini-2.0-flash

# Base directory the Filesystem MCP server is allowed to touch.
# The chatbot can only read/write files inside this folder (sandbox).
FILESYSTEM_ROOT=./workspace

# URL of the REMOTE pharmacy MCP server (item 6).
# Leave the localhost value to test locally; replace with your Cloud Run URL
# once deployed, e.g. https://pharmacy-mcp-xxxx-uc.a.run.app/mcp
PHARMACY_REMOTE_URL=http://127.0.0.1:8000/mcp

# Optional shared secret sent as a header to the remote MCP server.
PHARMACY_API_KEY=demo-key
